# =========================================================================
# Spring Boot Authentication Service - Environment Variables
# =========================================================================

# Database Configuration (PostgreSQL in production, H2 in local development)
DATABASE_URL=jdbc:postgresql://localhost:5432/liberatedb
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-secure-db-password
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT Security Configuration
# Minimum 256-bit Base64-encoded secret key (e.g., generate with: openssl rand -base64 32)
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLTI1Ni1iaXQtc2VjcmV0LWtleS1mb3ItbGliZXJhdGUtYXBw

# Google OAuth2 Client IDs (for cryptographic Google ID Token signature verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server Port
SERVER_PORT=8080
