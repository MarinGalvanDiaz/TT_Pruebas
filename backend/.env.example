# =========================================================================
# Spring Boot Authentication Service - Environment Variables
# =========================================================================

# -------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL en producción, H2 en desarrollo local)
# -------------------------------------------------------------------------
# Para PostgreSQL:
DATABASE_URL=jdbc:postgresql://localhost:5432/liberatedb
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=tu-password-de-postgresql
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Para desarrollo rápido en memoria (H2), puedes descomentar:
# DATABASE_URL=jdbc:h2:mem:liberatedb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# DATABASE_DRIVER=org.h2.Driver
# DATABASE_USERNAME=sa
# DATABASE_PASSWORD=
# JPA_DIALECT=org.hibernate.dialect.H2Dialect

# -------------------------------------------------------------------------
# 2. Seguridad JWT (Firma y Validación de Tokens)
# -------------------------------------------------------------------------
# Clave secreta Base64 de mínimo 256 bits (genera con: openssl rand -base64 32)
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLTI1Ni1iaXQtc2VjcmV0LWtleS1mb3ItbGliZXJhdGUtYXBw

# -------------------------------------------------------------------------
# 3. Google OAuth2 (Autenticación federada con Google)
# -------------------------------------------------------------------------
# Client ID obtenido de Google Cloud Console -> Credenciales -> ID de cliente OAuth 2.0
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# -------------------------------------------------------------------------
# 4. Mailtrap SMTP (Validación de cuentas y recuperación de contraseña)
# -------------------------------------------------------------------------
# Dominio verificado: luminar.top | Correo de soporte: soporte@luminar.top
MAILTRAP_DOMAIN=luminar.top
MAILTRAP_API_TOKEN=tu-mailtrap-api-token-aqui

# MODO PRODUCCIÓN (Mailtrap Email Sending con tu dominio luminar.top):
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=tu-mailtrap-api-token-aqui
MAIL_FROM=Libérate <soporte@luminar.top>

# MODO PRUEBAS / SANDBOX (Mailtrap Email Testing):
# Si deseas interceptar correos en tu Inbox de Mailtrap sin enviar correos reales:
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=tu-username-de-inbox-mailtrap
# MAIL_PASSWORD=tu-password-de-inbox-mailtrap

# -------------------------------------------------------------------------
# 5. URLs y Puerto de Servidor
# -------------------------------------------------------------------------
# URL base del frontend para generar enlaces en los correos (/verify-email, /reset-password)
FRONTEND_URL=http://localhost:8081
SERVER_PORT=8080
