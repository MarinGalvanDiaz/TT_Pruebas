# =========================================================================
# Spring Boot Authentication Service - Environment Variables
# =========================================================================

# 1. Base de Datos (PostgreSQL)
DATABASE_URL=jdbc:postgresql://db:5432/liberatedb
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=tu-password-de-postgresql
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# 2. Seguridad JWT
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLTI1Ni1iaXQtc2VjcmV0LWtleS1mb3ItbGliZXJhdGUtYXBw

# 3. Google OAuth2
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# 4. Mailtrap SMTP y HTTP API
MAILTRAP_DOMAIN=luminar.top
MAILTRAP_API_TOKEN=tu-mailtrap-api-token-aqui
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=tu-mailtrap-api-token-aqui
MAIL_FROM=Libérate <soporte@luminar.top>

# 5. URLs Públicas y Puerto de Servidor
FRONTEND_URL=https://luminar.top
CORS_ALLOWED_ORIGINS=*
SERVER_PORT=8080
