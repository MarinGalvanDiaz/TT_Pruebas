{
  "expo": {
    "name": "Libérate",
    "slug": "liberate-frontend",
    "scheme": "liberate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#fbf9f5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "top.luminar.liberate"
    },
    "android": {
      "package": "top.luminar.liberate",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#d1c4e9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Libérate - Tu espacio seguro",
      "shortName": "Libérate",
      "themeColor": "#635979",
      "backgroundColor": "#fbf9f5"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "6e69a652-c5e7-46ab-8c0a-9c66fc1eebf7"
      }
    }
  }
}
