# =============================================================================
# LIBÉRATE - Variables de Entorno para Docker y Desarrollo Local
# =============================================================================
# Copia este archivo como .env en la raíz del proyecto para personalizar los valores:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=liberatedb
POSTGRES_USER=postgres
DATABASE_PASSWORD=n0m3l0

# Puerto externo de PostgreSQL en el host (por defecto 5433 para evitar colisión si ya tienes PostgreSQL en 5432)
DATABASE_PORT=5433

# -----------------------------------------------------------------------------
# 2. Puertos de Servicios Web
# -----------------------------------------------------------------------------
# Backend Spring Boot (API REST)
BACKEND_PORT=8080

# Frontend Web (Nginx / Expo)
FRONTEND_PORT=8081

# -----------------------------------------------------------------------------
# 3. Seguridad JWT (Tokens de Acceso y Refresco)
# -----------------------------------------------------------------------------
# Clave Base64 secreta de mínimo 256 bits para firmar tokens JWT
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLTI1Ni1iaXQtc2VjcmV0LWtleS1mb3ItbGliZXJhdGUtYXBw

# -----------------------------------------------------------------------------
# 4. Servicio de Correo (Mailtrap SMTP)
# -----------------------------------------------------------------------------
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=tu-mailtrap-api-token-aqui
MAIL_FROM=Libérate <soporte@luminar.top>
MAILTRAP_DOMAIN=luminar.top
MAILTRAP_API_TOKEN=tu-mailtrap-api-token-aqui

# Para pruebas en Sandbox de Mailtrap (sin envío a correos reales):
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=tu-username-de-inbox
# MAIL_PASSWORD=tu-password-de-inbox

# -----------------------------------------------------------------------------
# 5. Frontend & URLs
# -----------------------------------------------------------------------------
# URL pública del frontend (usada para generar links en los correos de verificación)
FRONTEND_URL=http://localhost:8081

# URL de API para la compilación web de Expo (con Nginx se usa /api para proxy relativo)
EXPO_PUBLIC_API_URL=/api

# Google OAuth2 Client ID (Opcional)
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
