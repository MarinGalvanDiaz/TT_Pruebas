# =============================================================================
# Git Ignore for Libérate (Monorepo: Frontend + Backend)
# =============================================================================

# Dependencies
node_modules/
frontend/node_modules/

# Expo & Web builds
.expo/
frontend/.expo/
dist/
frontend/dist/
web-build/
frontend/web-build/
expo-env.d.ts
frontend/expo-env.d.ts

# Backend / Maven / Java
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# IDE & OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Environment variables & secrets (NEVER commit credentials)
.env
.env.*
.env*.local
*.env
*.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Native builds
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
frontend/ios/
frontend/android/
/ios
/android

# Logs & Metro
npm-debug.*
yarn-debug.*
yarn-error.*
.metro-health-check*
*.log
backend/logs/

# Typescript
*.tsbuildinfo
frontend/*.tsbuildinfo
docker-compose.yml